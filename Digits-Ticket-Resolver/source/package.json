{
	"name": "fw-dew-starter",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"description": "Starter kit that installs Freshworks Dew packages from the public npm registry at latest",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "node --test \"src/**/*.test.ts\"",
		"postinstall": "node scripts/refresh-dew-latest.mjs"
	},
	"dependencies": {
		"@freshworks/dew-components": "latest",
		"@freshworks/dew-mcp-server": "latest",
		"@freshworks/dew-styles": "latest",
		"@freshworks/dew-theme-generator": "latest",
		"motion": "^12.43.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^7.17.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^25.9.3",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^4.7.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.3"
	}
}
